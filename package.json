{
  "name": "noteforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "A local-first auditory-motor music laboratory.",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "tsc -b && vite build --config vite.config.ts && node scripts/stamp-service-worker.mjs",
    "preview": "vite preview --config vite.config.ts",
    "audit:architecture": "node scripts/audit-architecture.mjs --enforce",
    "proof:note-input:browser": "npm run build && node scripts/prove-note-input-browser.mjs",
    "proof:user-owned-traces:browser": "npm run build && node scripts/prove-user-owned-live-traces-browser.mjs",
    "proof:sustained-note:browser": "npm run build && node scripts/prove-sustained-note-browser.mjs",
    "proof:range-loop-noisy:browser": "npm run build && node scripts/prove-range-loop-noisy-browser.mjs",
    "proof:voice-draw:browser": "npm run build && node scripts/prove-voice-draw-browser.mjs",
    "proof:vocal-flight:browser": "npm run build && node scripts/prove-vocal-flight-browser.mjs",
    "proof:pitch-tunnel:browser": "npm run build && node scripts/prove-pitch-tunnel-browser.mjs",
    "proof:pitch-match:responsive": "npm run build && node scripts/prove-pitch-match-responsive.mjs",
    "proof:mobile-note-playback:layout": "npm run build && node scripts/prove-mobile-note-playback-layout.mjs",
    "proof:tone-map:browser": "npm run build && node scripts/prove-tone-map-browser.mjs",
    "proof:monitoring:browser": "npm run build && node scripts/prove-monitoring-browser.mjs",
    "proof:offline:browser": "npm run build && node scripts/prove-offline-browser.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --testTimeout=30000",
    "test:watch": "vitest",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "typescript": "6.0.3",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
